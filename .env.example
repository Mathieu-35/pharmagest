# --- Obligatoire en production (DJANGO_DEBUG=False) ---
DJANGO_SECRET_KEY=remplacer-par-une-longue-cle-secrete-d-au-moins-32-caracteres
DJANGO_DEBUG=True
# Noms de domaine séparés par des virgules, par exemple : pharmacie.exemple.mg
DJANGO_ALLOWED_HOSTS=
# Si le HTTPS est géré par nginx : DJANGO_PROXY_HTTPS=True
# DJANGO_PROXY_HTTPS=True

# --- Base de données : sqlite (développement) ou postgresql (production) ---
DB_ENGINE=sqlite
# DB_ENGINE=postgresql
# DB_NAME=pharmagest
# DB_USER=pharmagest
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Dossier des sauvegardes (par défaut : dossier « sauvegardes » du projet)
# SAUVEGARDES_DIR=
# Jours avant péremption pour signaler un lot « proche de la péremption »
JOURS_ALERTE_PEREMPTION=30
# Réinitialisation du mot de passe : par défaut les e-mails s'affichent dans le terminal
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.exemple.mg
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DJANGO_DEFAULT_FROM_EMAIL=PharmaGest <pharmacie@exemple.mg>

# Informations imprimées sur les documents PDF
PHARMACIE_NOM=PharmaGest
PHARMACIE_ADRESSE=
PHARMACIE_TELEPHONE=
PHARMACIE_EMAIL=
PHARMACIE_NUMERO_FISCAL=
# Mentions légales et fiscales applicables (Madagascar ou territoire d'exploitation)
PHARMACIE_MENTIONS_LEGALES=
DEVISE=Ar
